<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Always-on dispatcher. Installed by make install-agent.
  Placeholders (WRAPPER, APPLE_TASKS_BIN, HOME, INTERVAL) are substituted at install.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple-tasks.dispatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>@WRAPPER@</string>
		<string>@APPLE_TASKS_BIN@</string>
		<string>dispatch</string>
	</array>
	<key>StartInterval</key>
	<integer>@INTERVAL@</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>@HOME@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- launchd has a tiny default PATH; agents (claude, agent, agy) live in these dirs. -->
		<key>PATH</key>
		<string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>APPLE_TASKS_CALLER</key>
		<string>launchd</string>
	</dict>
	<key>StandardOutPath</key>
	<string>@HOME@/.config/apple-tasks/logs/dispatch.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.config/apple-tasks/logs/dispatch.stderr.log</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ThrottleInterval</key>
	<integer>60</integer>
</dict>
</plist>
