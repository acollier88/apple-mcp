<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dispatcher watchdog (#56). Separate from com.apple-tasks.dispatch so a stuck
  pass can still be noticed. Install beside the dispatcher plist; this file
  is not loaded by `make install-agent`.
  Placeholders match the dispatcher plist and are substituted the same way.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple-tasks.watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>@WRAPPER@</string>
		<string>@APPLE_TASKS_BIN@</string>
		<string>watchdog</string>
		<string>--quiet</string>
	</array>
	<key>StartInterval</key>
	<integer>180</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>@HOME@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>APPLE_TASKS_CALLER</key>
		<string>launchd</string>
	</dict>
	<key>StandardOutPath</key>
	<string>@HOME@/.config/apple-tasks/logs/watchdog.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.config/apple-tasks/logs/watchdog.stderr.log</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ThrottleInterval</key>
	<integer>60</integer>
</dict>
</plist>
